        {
          "t": 0,
          "type": "plan_adopted",
          "plan": {
            "plan_id": "p1",
            "delivered_kbps": 63000,
            "quality": "auto",
            "available_qualities": [
              {
                "label": "original",
                "preserves_source": true,
                "bitrate_kbps": 63000
              },
              {
                "label": "1080p-high",
                "preserves_source": false,
                "height": 1080,
                "bitrate_kbps": 10000
              },
              {
                "label": "1080p-medium",
                "preserves_source": false,
                "height": 1080,
                "bitrate_kbps": 6000
              },
              {
                "label": "720p-high",
                "preserves_source": false,
                "height": 720,
                "bitrate_kbps": 4000
              }
            ]
          }
        },
        {
          "t": 0,
          "type": "playing"
        },
        {
          "t": 125000,
          "type": "waiting"
        }
      ],
      "until": 140000,
      "expect": [
        {
          "t": 131000,
          "type": "replan",
          "body": {
            "operation": "quality_change",
            "quality_preference": "auto",
            "bandwidth_estimate_kbps": 44100,
