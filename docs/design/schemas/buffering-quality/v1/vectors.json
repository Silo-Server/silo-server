{
  "version": 1,
  "spec": "docs/design/2026-10-17-buffering-quality.md",
  "about": "Replay each case against the buffering-quality controller with a fake wall clock. Apply each event at its time t (ms on the case clock), advancing the clock between events so timers fire, then advance to until. expect is the complete ordered list of outputs; any other output fails the case. A case's mode defaults to defaults.mode. buffering_action, when present, is the plan_summary value each listed plan must report.",
  "constants": {
    "STARTUP_GRACE_MS": 10000,
    "STALL_MIN_MS": 1000,
    "STALLS_BEFORE_TRIGGER": 2,
    "STALL_WINDOW_MS": 120000,
    "LONG_STALL_MS": 6000,
    "PROMPT_SECONDS": 15,
    "REOFFER_MIN_MS": 120000,
    "NO_LOWER_COOLDOWN_MS": 300000,
    "REARM_AFTER_UNADOPTED_MS": 60000,
    "STEP_DOWN_RATIO": 0.7,
    "MIN_ESTIMATE_KBPS": 100
  },
  "copy": {
    "prompt_title": "Playback keeps buffering",
    "prompt_lower": "Lower quality",
    "prompt_keep": "Keep quality",
    "undo_caption": "Quality lowered to stop buffering",
    "undo_action": "Restore quality",
    "lowered": "Quality lowered to stop buffering",
    "cant_lower": "Can't lower quality for this video"
  },
  "event_types": [
    "plan_adopted",
    "playing",
    "waiting",
    "pause",
    "seek",
    "transport_error_start",
    "transport_error_end",
    "replan_failed",
    "select_lower",
    "select_keep",
    "select_restore",
    "back"
  ],
  "output_types": [
    "replan",
    "prompt_shown",
    "undo_shown",
    "notice"
  ],
  "defaults": {
    "mode": "always"
  },
  "cases": [
    {
      "name": "long_stall",
