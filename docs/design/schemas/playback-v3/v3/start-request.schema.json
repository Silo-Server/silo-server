{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silo-server.dev/schemas/playback-v3/v3/start-request.schema.json",
  "title": "Silo Playback Protocol v3 Start Request",
  "description": "Body of POST /api/v1/playback/start. Bounds mirror StartRequestV3.NormalizeAndValidate and validateCapabilitiesV3 in internal/playback/protocol_v3.go. STRING LENGTHS: every `maxLength` here is a character count, while the server enforces the same limit as a UTF-8 byte length (Go `len(string)`), so a value near a cap that contains multi-byte characters can satisfy this schema yet be rejected at ingest. JSON Schema cannot express byte length, so the divergence is documented rather than encoded.",
  "type": "object",
  "required": [
    "protocol_version",
    "file_id",
    "profile_id",
    "playback_attempt_id",
    "subtitle_fidelity_preference",
    "client_capabilities",
    "client_playback_context"
  ],
  "properties": {
    "protocol_version": {
      "type": "integer",
      "const": 3
    },
    "client_features": {
      "$ref": "#/$defs/feature_list"
    },
    "file_id": {
      "type": "integer",
      "minimum": 1
    },
    "profile_id": {
      "type": "string",
      "description": "Must equal the X-Profile-Id header on the request; the server rejects a mismatch.",
      "minLength": 1
    },
    "playback_attempt_id": {
      "$ref": "#/$defs/bounded_identifier"
    },
    "quality_preference": {
      "type": "string",
      "description": "Free-form and deliberately unbounded: the server normalizes an unrecognized value to \"auto\" and returns a quality_preference_normalized degradation warning rather than rejecting the request. Values that survive include auto, original, the plain resolution preferences, and compound menu rungs such as 2160p-medium and 1080p-low."
    },
    "subtitle_fidelity_preference": {
      "type": "string",
      "enum": [
        "preserve",
        "compatible"
      ],
      "maxLength": 32
    },
    "start_position": {
      "type": "number",
      "description": "Where in the source to begin, in seconds. Omitting it asks the server for the profile's saved resume point (0 when there is none, when the item is already complete, or when the file is one part of a multipart item); sending 0 explicitly means start over. Resolved before planning, because the plan's timeline is cut at the start position.",
      "minimum": 0,
      "maximum": 31536000
    },
    "progress_persistence": {
      "type": "string",
      "description": "Who owns durable item resume/history persistence. Omission defaults to server. client keeps session heartbeats live but suppresses server item progress writes and requires an explicit start_position.",
      "enum": [
        "server",
        "client"
      ],
      "default": "server"
    },
    "audio_track_id": {
      "description": "Omitting both audio fields asks the server for the profile's preferred track, resolved from the series preference, then the profile audio-language setting, then the library override. Sending either one selects exactly that track.",
      "$ref": "#/$defs/track_id"
    },
    "audio_track_index": {
      "$ref": "#/$defs/track_index"
    },
    "subtitle_track_id": {
      "$ref": "#/$defs/track_id"
    },
    "subtitle_track_index": {
      "$ref": "#/$defs/track_index"
    },
    "metered": {
      "type": "boolean"
    },
    "bandwidth_estimate_kbps": {
      "$ref": "#/$defs/bandwidth_kbps"
    },
    "bandwidth_cap_kbps": {
      "$ref": "#/$defs/bandwidth_kbps"
    },
    "client_capabilities": {
      "$ref": "#/$defs/client_capabilities"
    },
    "client_playback_context": {
      "$ref": "#/$defs/client_playback_context"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "progress_persistence": {
            "const": "client"
          }
        },
        "required": [
          "progress_persistence"
        ]
      },
      "then": {
        "required": [
          "start_position"
        ]
      }
    }
  ],
  "$defs": {
    "bounded_identifier": {
      "type": "string",
      "description": "Opaque client-minted identifier. The server matches ^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$, so the value is 8 to 128 characters and starts alphanumeric.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$",
      "minLength": 8,
      "maxLength": 128
    },
    "track_id": {
      "type": "string",
      "description": "Combined-ordinal track identity `file:{file_id}:{audio|subtitle}:{ordinal}`. When the matching index field is also sent the two must agree; the server rebuilds the identity from file_id and index and compares byte-for-byte.",
      "maxLength": 128
    },
    "track_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "bandwidth_kbps": {
      "type": "integer",
      "minimum": 100,
      "maximum": 1000000
    },
    "feature_list": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "capability_value_list": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "delivery_value_list": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "maxLength": 64
      }
    },
    "capability_evidence": {
      "type": "string",
      "description": "How the capability facts were produced. `exact` is a real platform probe with per-codec profiles/levels/bounds, `platform_attested` a platform-backed decoder-stack attestation without profile enumeration, `declared` a boolean support statement. Planner strictness follows the tier; bounded software entries require the explicit software-video feature.",
      "enum": [
        "exact",
        "platform_attested",
        "declared"
      ],
      "maxLength": 32
    },
    "hdr_capabilities": {
      "type": "object",
      "properties": {
        "hdr10": {
          "type": "boolean"
        },
        "hdr10_plus": {
          "type": "boolean"
        },
        "hlg": {
          "type": "boolean"
        },
        "hdr10_max_width": {
          "type": "integer",
          "minimum": 0
        },
        "hdr10_max_height": {
          "type": "integer",
          "minimum": 0
        },
        "hdr10_max_frame_rate": {
          "type": "number",
          "minimum": 0
        },
        "hdr10_max_bitrate_kbps": {
          "type": "integer",
          "minimum": 0
        },
        "dolby_vision_profiles": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "integer"
          }
        },
        "dolby_vision_profile_levels": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": [
              "profile",
              "max_level"
            ],
            "properties": {
              "profile": {
                "type": "integer",
                "minimum": 1
              },
              "max_level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 13
              },
              "bl_compatibility_ids": {
                "type": "array",
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 15
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              { "required": ["hdr10_max_width"] },
              { "required": ["hdr10_max_height"] },
              { "required": ["hdr10_max_frame_rate"] },
              { "required": ["hdr10_max_bitrate_kbps"] }
            ]
          },
          "then": {
            "required": ["hdr10"],
            "properties": { "hdr10": { "const": true } }
          }
        }
      ],
      "additionalProperties": true
    },
    "audio_passthrough": {
      "type": "object",
      "properties": {
        "passthrough_codecs": {
          "$ref": "#/$defs/delivery_value_list"
        },
        "spatializer_enabled": {
          "type": "boolean"
        },
        "max_channels": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "entries": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "properties": {
              "codec": {
                "type": "string",
                "maxLength": 64
              },
              "channel_counts": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "integer"
                }
              },
              "layouts": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "video_decode_capability": {
      "type": "object",
      "required": [
        "codec"
      ],
      "properties": {
        "codec": {
          "type": "string",
          "minLength": 1
        },
        "decoder_name": {
          "type": "string",
          "maxLength": 128
        },
        "profiles": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 64
          }
        },
        "levels": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "integer"
          }
        },
        "bit_depths": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "integer"
          }
        },
        "max_width": {
          "type": "integer",
          "minimum": 0
        },
        "max_height": {
          "type": "integer",
          "minimum": 0
        },
        "max_frame_rate": {
          "type": "number",
          "minimum": 0
        },
        "max_bitrate_kbps": {
          "type": "integer",
          "minimum": 0
        },
        "hardware": {
          "type": "boolean",
          "description": "Whether this entry uses a hardware decoder. At strict evidence tiers, false entries participate only when client_features includes software_video_decode_v1."
        }
      },
      "additionalProperties": true
    },
    "client_capabilities": {
      "type": "object",
      "required": [
        "video_evidence",
        "audio_evidence"
      ],
      "properties": {
        "video_evidence": {
          "$ref": "#/$defs/capability_evidence"
        },
        "audio_evidence": {
          "$ref": "#/$defs/capability_evidence"
        },
        "codecs_video": {
          "$ref": "#/$defs/capability_value_list"
        },
        "codecs_video_hardware": {
          "$ref": "#/$defs/capability_value_list"
        },
        "codecs_audio": {
          "$ref": "#/$defs/capability_value_list"
        },
        "containers": {
          "$ref": "#/$defs/capability_value_list"
        },
        "max_resolution": {
          "type": "string",
          "maxLength": 32
        },
        "hdr": {
          "type": "boolean"
        },
        "hdr_details": {
          "$ref": "#/$defs/hdr_capabilities"
        },
        "audio_passthrough": {
          "$ref": "#/$defs/audio_passthrough"
        },
        "video_decode": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/video_decode_capability"
          }
        }
      },
      "additionalProperties": true
    },
    "transformation_capability": {
      "type": "object",
      "required": [
        "name",
        "executor",
        "recipe_version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "executor": {
          "type": "string",
          "enum": [
            "client",
            "server"
          ]
        },
        "recipe_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "validated_claims": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 128
          }
        }
      },
      "additionalProperties": true
    },
    "delivery_capability": {
      "type": "object",
      "description": "One negotiated delivery class the client can execute. A `client` executor transformation is only accepted on a delivery that is enabled and supported_on_device, and only when client_features advertises client_video_transformations_v1; (executor, name, recipe_version) must be unique within the delivery.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "supported_on_device": {
          "type": "boolean"
        },
        "failure_reason": {
          "type": "string"
        },
        "containers": {
          "$ref": "#/$defs/delivery_value_list"
        },
        "video_codecs": {
          "$ref": "#/$defs/delivery_value_list"
        },
        "audio_decode_codecs": {
          "$ref": "#/$defs/delivery_value_list"
        },
        "audio_passthrough_codecs": {
          "$ref": "#/$defs/delivery_value_list"
        },
        "max_channels": {
          "type": "integer"
        },
        "hdr_details": {
          "$ref": "#/$defs/hdr_capabilities"
        },
        "subtitles": {
          "type": "object",
          "properties": {
            "embedded_text": {
              "type": "boolean"
            },
            "sidecar_text": {
              "type": "boolean"
            },
            "ass_styling": {
              "type": "boolean"
            },
            "embedded_bitmap": {
              "type": "boolean"
            },
            "sidecar_bitmap": {
              "type": "boolean"
            },
            "font_attachments": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "features": {
          "$ref": "#/$defs/delivery_value_list"
        },
        "auth_header_refresh": {
          "type": "boolean"
        },
        "validated_claims": {
          "$ref": "#/$defs/delivery_value_list"
        },
        "transformations": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/transformation_capability"
          }
        }
      },
      "additionalProperties": true
    },
    "client_playback_context": {
      "type": "object",
      "required": [
        "protocol_version"
      ],
      "properties": {
        "protocol_version": {
          "type": "integer",
          "const": 3
        },
        "form_factor": {
          "type": "string",
          "maxLength": 32
        },
        "app_version": {
          "type": "string",
          "maxLength": 64
        },
        "app_build": {
          "type": "string",
          "maxLength": 64
        },
        "app_channel": {
          "type": "string",
          "maxLength": 32
        },
        "device": {
          "type": "object",
          "description": "Manufacturer and model stay first-class because the device-quirk registry matches on them. Everything platform-specific travels in platform_details as opaque bounded strings.",
          "properties": {
            "platform": {
              "type": "string",
              "maxLength": 32
            },
            "os_version": {
              "type": "string",
              "maxLength": 128
            },
            "manufacturer": {
              "type": "string",
              "maxLength": 128
            },
            "model": {
              "type": "string",
              "maxLength": 128
            },
            "platform_details": {
              "type": "object",
              "maxProperties": 16,
              "propertyNames": {
                "minLength": 1,
                "maxLength": 128
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 128
              }
            }
          },
          "additionalProperties": true
        },
        "output": {
          "type": "object",
          "properties": {
            "hdr_details": {
              "$ref": "#/$defs/hdr_capabilities"
            },
            "audio_passthrough": {
              "$ref": "#/$defs/audio_passthrough"
            },
            "current_sink": {
              "type": "string",
              "maxLength": 128
            },
            "sink_type": {
              "type": "string",
              "maxLength": 128
            },
            "output_context_id": {
              "type": "string",
              "description": "Opaque token identifying the current output route. The server only ever compares it for equality, so any stable platform-native identity works and omitting it is valid.",
              "maxLength": 128
            }
          },
          "additionalProperties": true
        },
        "deliveries": {
          "type": "object",
          "description": "Keyed by delivery class: original_http, progressive, hls. A class the client omits is a class the planner will not route to.",
          "maxProperties": 16,
          "propertyNames": {
            "maxLength": 64
          },
          "additionalProperties": {
            "$ref": "#/$defs/delivery_capability"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
