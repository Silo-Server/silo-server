  "household.other_account_profile": {
    "method": "GET",
    "path": "/api/v1/profiles/household/sessions",
    "scenario": {
      "id": "household.other_account_profile",
      "category": "authorization",
      "description": "A member bearer declaring a profile owned by another account (the admin's primary) is 404 not_found from viewer access: the profile lookup is scoped to the bearer's account, so a foreign profile is indistinguishable from an unknown one.",
      "principal": {
        "class": "profile",
        "profile": "admin_primary"
      },
      "request": {
        "path": "/api/v1/profiles/household/sessions"
      },
      "expect": {
        "status": 404,
        "headers": [
          {
            "name": "Content-Type",
            "op": "equals",
            "value": "application/json"
          }
        ],
        "body": [
          {
            "pointer": "/error",
            "op": "equals",
            "value": "not_found"
          },
          {
            "pointer": "",
            "op": "keys_equal",
            "value": [
              "error",
              "message"
            ]
          },
          {
            "pointer": "/error",
            "op": "type",
            "value": "string"
          },
          {
            "pointer": "/message",
            "op": "type",
            "value": "string"
          },
          {
            "pointer": "/message",
            "op": "equals",
            "value": "Profile not found"
          }
        ]
      },
      "notes": "Cross-account probe. The 404 (not 403) is the current scoped-lookup behavior; recorded as-is.",
      "v2_expectation": null
    },
    "pair": {
      "kind": "intentional_difference",
      "summary": "Preserve household authority with canonical collection/Problems. Quality maps original STANDARD alias to declared v2 1080p while both store 1080p; original request unchanged.",
      "recorded_in": "internal/scenariocatalog/executor/household_authority_pairing_test.go",
      "operation_id": "listHouseholdSessions",
      "method": "GET",
      "request": {
        "path": "/api/v2/profiles/household/sessions"
      },
      "expect": {
        "status": 404,
        "headers": [
          {
            "name": "Content-Type",
            "op": "equals",
            "value": "application/problem+json"
          },
          {
            "name": "Cache-Control",
            "op": "equals",
            "value": "no-store"
          }
        ],
        "body": [
          {
            "pointer": "/status",
            "op": "equals",
            "value": 404
          },
          {
            "pointer": "/type",
            "op": "matches",
            "value": "/not_found$"
          }
        ]
      }
    }
  },
