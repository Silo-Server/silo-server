{
  "profiles_update.quality_normalized": {
    "method": "PUT",
    "path": "/api/v1/profiles/{id}",
    "scenario": {
      "id": "profiles_update.quality_normalized",
      "category": "filtering",
      "description": "Quality presets are normalized: 720P/1080P/STANDARD all store the 1080p tier; ANY stores empty.",
      "principal": {
        "class": "primary_profile"
      },
      "request": {
        "path": "/api/v1/profiles/${profile_secondary}",
        "body": {
          "max_playback_quality": "STANDARD"
        }
      },
      "expect": {
        "status": 200,
        "body": [
          {
            "pointer": "/max_playback_quality",
            "op": "equals",
            "value": "1080p"
          }
        ]
      },
      "fresh_state": true,
      "v2_expectation": null
    },
    "pair": {
      "kind": "intentional_difference",
      "summary": "Preserve household authority with canonical collection/Problems. Quality maps original STANDARD alias to declared v2 1080p while both store 1080p; original request unchanged.",
      "recorded_in": "internal/scenariocatalog/executor/household_authority_pairing_test.go",
      "operation_id": "updateProfile",
      "method": "PATCH",
      "request": {
        "path": "/api/v2/profiles/${profile_secondary}",
        "body": {
          "max_playback_quality": "1080p"
        }
      },
      "expect": {
        "status": 200,
        "headers": [
          {
            "name": "Content-Type",
            "op": "equals",
            "value": "application/json"
          },
          {
            "name": "Cache-Control",
            "op": "equals",
            "value": "no-store"
          }
        ],
        "body": [
          {
            "pointer": "/max_playback_quality",
            "op": "equals",
            "value": "1080p"
          }
        ]
      }
    }
  },
