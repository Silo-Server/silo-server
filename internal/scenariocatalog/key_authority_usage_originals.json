  "me.api_key": {
    "method": "GET",
    "path": "/api/v1/auth/me",
    "scenario": {
      "id": "me.api_key",
      "category": "authorization",
      "description": "An unscoped API key passes the auth middleware but the handler re-parses the Authorization header as a JWT and refuses it with 401.",
      "principal": {
        "class": "api_key"
      },
      "request": {
        "path": "/api/v1/auth/me"
      },
      "expect": {
        "status": 401,
        "headers": [
          {
            "name": "Content-Type",
            "op": "equals",
            "value": "application/json"
          }
        ],
        "body": [
          {
            "pointer": "/error",
            "op": "equals",
            "value": "unauthorized"
          },
          {
            "pointer": "",
            "op": "keys_equal",
            "value": [
              "error",
              "message"
            ]
          },
          {
            "pointer": "/error",
            "op": "type",
            "value": "string"
          },
          {
            "pointer": "/message",
            "op": "type",
            "value": "string"
          },
          {
            "pointer": "/message",
            "op": "equals",
            "value": "Invalid or missing authentication token"
          }
        ]
      },
      "notes": "Accidental: /auth/me, /auth/logout, /auth/sessions, and /auth/impersonation/end call extractClaims on the raw header instead of reading the middleware's claims, so API keys are rejected after authenticating. Flagged for the section PR.",
      "v2_expectation": null
    }
  },
