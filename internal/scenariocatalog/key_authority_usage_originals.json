{
  "keys_list.api_key_forbidden": {
    "method": "GET",
    "path": "/api/v1/api-keys/",
    "scenario": {
      "id": "keys_list.api_key_forbidden",
      "category": "authorization",
      "description": "An API key may not manage API keys: 403.",
      "principal": {
        "class": "api_key"
      },
      "request": {
        "path": "/api/v1/api-keys/"
      },
      "expect": {
        "status": 403,
        "headers": [
          {
            "name": "Content-Type",
            "op": "equals",
            "value": "application/json"
          }
        ],
        "body": [
          {
            "pointer": "/error",
            "op": "equals",
            "value": "forbidden"
          },
          {
            "pointer": "",
            "op": "keys_equal",
            "value": [
              "error",
              "message"
            ]
          },
          {
            "pointer": "/error",
            "op": "type",
            "value": "string"
          },
          {
            "pointer": "/message",
            "op": "type",
            "value": "string"
          },
          {
            "pointer": "/message",
            "op": "equals",
            "value": "API key management is not accessible via API key authentication"
          }
        ]
      },
      "v2_expectation": null
    }
  },
