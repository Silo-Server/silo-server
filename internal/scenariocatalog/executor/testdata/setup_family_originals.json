  {
    "id": "setup.data_meaning",
    "category": "data_meaning",
    "description": "Setup is only possible on an empty users table; the fixture household is never empty so a success cannot be observed here.",
    "principal": {
      "class": "public"
    },
    "request": {
      "path": "/api/v1/auth/setup",
      "body": {
        "username": "fixture-owner",
        "email": "fixture-owner@silo.example.test",
        "password": "fixture-owner-password",
        "create_default_profile": true,
        "default_profile_name": "Owner"
      }
    },
    "expect": {
      "status": 401,
      "body": [
        {
          "pointer": "/error",
          "op": "equals",
          "value": "setup_complete"
        }
      ]
    },
    "requires": [
      "database"
    ],
    "notes": "The 201 success path (login response shape with create_default_profile) is untestable against the seeded household; covered by unit tests in internal/auth. Section PR must add an empty-database scenario.",
    "v2_expectation": null
  },
  {
    "id": "setup.already_complete.r1",
    "category": "authorization",
    "description": "Once any user exists, setup is refused with 401 setup_complete even for valid input.",
    "principal": {
      "class": "public"
    },
    "request": {
      "path": "/api/v1/auth/setup",
      "body": {
        "username": "fixture-owner",
        "email": "fixture-owner@silo.example.test",
        "password": "fixture-owner-password",
        "create_default_profile": true,
        "default_profile_name": "Owner"
      }
    },
    "expect": {
      "status": 401,
      "headers": [
        {
          "name": "Content-Type",
          "op": "equals",
          "value": "application/json"
        }
      ],
      "body": [
        {
          "pointer": "/error",
          "op": "equals",
          "value": "setup_complete"
        },
        {
          "pointer": "",
          "op": "keys_equal",
          "value": [
            "error",
            "message"
          ]
        },
        {
          "pointer": "/error",
          "op": "type",
          "value": "string"
        },
        {
          "pointer": "/message",
          "op": "type",
          "value": "string"
        },
        {
          "pointer": "/message",
          "op": "equals",
          "value": "Initial setup has already been completed"
        }
      ]
    },
    "requires": [
      "database"
    ],
    "notes": "Refusal is 401 (not 403/409) although no credential is involved; flagged for the section PR.",
    "v2_expectation": null
  },
