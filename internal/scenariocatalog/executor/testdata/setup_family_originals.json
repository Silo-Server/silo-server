  {
    "id": "setup.status_headers",
    "category": "status_headers",
    "description": "The refusal is a JSON error envelope.",
    "principal": {
      "class": "public"
    },
    "request": {
      "path": "/api/v1/auth/setup",
      "body": {
        "username": "fixture-owner",
        "email": "fixture-owner@silo.example.test",
        "password": "fixture-owner-password",
        "create_default_profile": true,
        "default_profile_name": "Owner"
      }
    },
    "expect": {
      "status": 401,
      "headers": [
        {
          "name": "Content-Type",
          "op": "equals",
          "value": "application/json"
        }
      ],
      "body": [
        {
          "pointer": "",
          "op": "keys_equal",
          "value": [
            "error",
            "message"
          ]
        },
        {
          "pointer": "/error",
          "op": "type",
          "value": "string"
        },
        {
          "pointer": "/message",
          "op": "type",
          "value": "string"
        }
      ]
    },
    "requires": [
      "database"
    ],
    "v2_expectation": null
  },
