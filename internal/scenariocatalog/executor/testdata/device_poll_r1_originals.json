[
  {
    "id": "device_poll.pending.r1",
    "category": "status_headers",
    "description": "Polling a pending request answers 200 with status pending and the poll interval.",
    "principal": {
      "class": "public"
    },
    "request": {
      "path": "/api/v1/auth/device/poll",
      "body": {
        "device_code": "${device_code}"
      }
    },
    "expect": {
      "status": 200,
      "headers": [
        {
          "name": "Content-Type",
          "op": "equals",
          "value": "application/json"
        }
      ],
      "body": [
        {
          "pointer": "",
          "op": "keys_equal",
          "value": [
            "status",
            "poll_after"
          ]
        },
        {
          "pointer": "/status",
          "op": "equals",
          "value": "pending"
        },
        {
          "pointer": "/poll_after",
          "op": "equals",
          "value": 3
        }
      ]
    },
    "requires": [
      "database"
    ],
    "v2_expectation": null
  },
  {
    "id": "device_poll.approved.r1",
    "category": "data_meaning",
    "description": "Polling an approved request consumes it and returns a full login (tokens plus user); no Cache-Control is set on the credential response.",
    "principal": {
      "class": "public"
    },
    "request": {
      "path": "/api/v1/auth/device/poll",
      "body": {
        "device_code": "${device_code_approved}"
      }
    },
    "expect": {
      "status": 200,
      "headers": [
        {
          "name": "Cache-Control",
          "op": "absent"
        }
      ],
      "body": [
        {
          "pointer": "/status",
          "op": "equals",
          "value": "approved"
        },
        {
          "pointer": "/access_token",
          "op": "non_empty"
        },
        {
          "pointer": "/refresh_token",
          "op": "non_empty"
        },
        {
          "pointer": "/expires_in",
          "op": "equals",
          "value": 28800
        },
        {
          "pointer": "/user/username",
          "op": "equals",
          "value": "${member_username}"
        },
        {
          "pointer": "/profile_id",
          "op": "absent"
        },
        {
          "pointer": "/temporary",
          "op": "absent"
        }
      ]
    },
    "requires": [
      "database"
    ],
    "fresh_state": true,
    "notes": "This response carries tokens or a profile token yet sets no Cache-Control (writeJSON only sets Content-Type), so a shared cache may store it. Pinned as the current behavior and flagged for the section PR as an accidental omission.",
    "v2_expectation": null
  },
  {
    "id": "device_poll.consumed.r1",
    "category": "data_meaning",
    "description": "A second poll after consumption reports status consumed without tokens.",
    "principal": {
      "class": "public"
    },
    "request": {
      "path": "/api/v1/auth/device/poll",
      "body": {
        "device_code": "${device_code_approved}"
      },
      "repeat": 2
    },
    "expect": {
      "status": 200,
      "body": [
        {
          "pointer": "/status",
          "op": "equals",
          "value": "consumed"
        },
        {
          "pointer": "/access_token",
          "op": "absent"
        }
      ]
    },
    "requires": [
      "database"
    ],
    "fresh_state": true,
    "v2_expectation": null
  },
  {
    "id": "device_poll.remote_approved.r1",
    "category": "field_presence_nullability",
    "description": "A remote-playback approval adds profile_id, profile_token, temporary, and session_expires_at.",
    "principal": {
      "class": "public"
    },
    "request": {
      "path": "/api/v1/auth/device/poll",
      "body": {
        "device_code": "${device_code_remote_approved}"
      }
    },
    "expect": {
      "status": 200,
      "body": [
        {
          "pointer": "/temporary",
          "op": "equals",
          "value": true
        },
        {
          "pointer": "/profile_id",
          "op": "equals",
          "value": "${profile_primary}"
        },
        {
          "pointer": "/profile_token",
          "op": "non_empty"
        },
        {
          "pointer": "/session_expires_at",
          "op": "rfc3339"
        }
      ]
    },
    "requires": [
      "database"
    ],
    "fresh_state": true,
    "v2_expectation": null
  },
