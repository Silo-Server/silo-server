#!/bin/sh
# sync-app-key-vectors: refreshes the app key protocol test vectors in
# internal/appkeys/testdata/vectors/v1 from a checkout of the protocol repository.
#
# The vectors live in a private repository, so CI can't fetch them; this
# repository keeps a committed copy. COMMIT names the protocol version the copy
# comes from. To move to a newer one, change COMMIT, run the script and commit
# the result together with any code the new vectors need.
#
# Usage, from anywhere inside this repository:
#   scripts/sync-app-key-vectors --local <checkout>
set -eu

COMMIT=3db77b2f05c12ae8651d857eae31ae7f0bddd042
FILES='signed-messages.json sealed-reply.json keys.json links.json'

die() { echo "sync-app-key-vectors: $*" >&2; exit 1; }

root=$(git rev-parse --show-toplevel)
local=''

while [ $# -gt 0 ]; do
  case $1 in
    --local) local=${2:?}; shift 2 ;;
    *) die "unknown argument $1" ;;
  esac
done

[ -n "$local" ] || die "pass --local <checkout>"
[ -d "$local" ] || die "$local does not exist"
git -C "$local" rev-parse --git-dir >/dev/null 2>&1 || die "$local is not a git checkout"
git -C "$local" cat-file -e "$COMMIT^{commit}" 2>/dev/null || die "$local has no commit $COMMIT; fetch it first"

dest=$root/internal/appkeys/testdata/vectors/v1
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT INT TERM

# Read every file before writing any, so a missing one changes nothing.
for f in $FILES; do
  git -C "$local" show "$COMMIT:vectors/v1/$f" >"$tmp/$f" || die "$COMMIT has no vectors/v1/$f"
done
mkdir -p "$dest"
for f in $FILES; do
  cp "$tmp/$f" "$dest/$f"
done
echo "sync-app-key-vectors: copied $FILES from $COMMIT" >&2
