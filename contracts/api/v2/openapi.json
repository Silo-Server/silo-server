{
  "components": {
    "schemas": {
      "Account": {
        "additionalProperties": false,
        "properties": {
          "download_allowed": {
            "description": "Whether the effective policy permits downloads",
            "type": "boolean"
          },
          "email": {
            "description": "Contact email; empty when none is set",
            "type": "string"
          },
          "id": {
            "description": "Account identifier",
            "minLength": 1,
            "type": "string"
          },
          "impersonation": {
            "$ref": "#/components/schemas/Impersonation",
            "description": "Present only while an administrator impersonates this account"
          },
          "permissions": {
            "description": "Effective assignable permissions; empty for a disabled account",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "role": {
            "description": "Server-wide role",
            "enum": [
              "admin",
              "user"
            ],
            "type": "string"
          },
          "username": {
            "description": "Login name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "email",
          "role",
          "permissions",
          "download_allowed"
        ],
        "type": "object"
      },
      "Impersonation": {
        "additionalProperties": false,
        "properties": {
          "active": {
            "description": "Always true when the object is present",
            "type": "boolean"
          },
          "impersonator_user_id": {
            "description": "The administrator account acting as this account",
            "minLength": 1,
            "type": "string"
          },
          "impersonator_username": {
            "description": "The administrator's username; empty when the account no longer exists",
            "type": "string"
          }
        },
        "required": [
          "active",
          "impersonator_user_id",
          "impersonator_username"
        ],
        "type": "object"
      },
      "PageInfo": {
        "additionalProperties": false,
        "properties": {
          "has_more": {
            "description": "Whether a next page exists",
            "type": "boolean"
          },
          "next_cursor": {
            "description": "Opaque cursor for the next page; absent on the last page",
            "type": "string"
          }
        },
        "required": [
          "has_more"
        ],
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "Safe occurrence-specific explanation; not for control flow",
            "type": "string"
          },
          "errors": {
            "description": "Field-level validation details",
            "items": {
              "$ref": "#/components/schemas/ProblemError"
            },
            "type": "array"
          },
          "instance": {
            "description": "urn:silo:request:\u003crequest-id\u003e, matching the X-Request-ID response header",
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code, equal to the response status",
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "Short summary fixed for the problem type",
            "type": "string"
          },
          "type": {
            "description": "Stable problem type URI; the final segment is the problem identifier",
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance"
        ],
        "type": "object"
      },
      "ProblemError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Stable machine-readable code for the failure",
            "type": "string"
          },
          "detail": {
            "description": "Safe human-readable explanation; never the rejected value",
            "type": "string"
          },
          "location": {
            "description": "Where the error occurred: body.*, query.*, path.* or header.*",
            "type": "string"
          }
        },
        "required": [
          "location",
          "code",
          "detail"
        ],
        "type": "object"
      },
      "Profile": {
        "additionalProperties": false,
        "properties": {
          "allowed_library_ids": {
            "description": "Libraries the profile may see when restrictions are enabled",
            "items": {
              "description": "Opaque identifier",
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "auto_play_next_preview": {
            "type": "boolean"
          },
          "auto_skip_credits": {
            "type": "boolean"
          },
          "auto_skip_intro": {
            "type": "boolean"
          },
          "auto_skip_recap": {
            "type": "boolean"
          },
          "avatar": {
            "description": "Avatar reference; empty when none",
            "type": "string"
          },
          "avatar_source": {
            "enum": [
              "none",
              "preset",
              "upload"
            ],
            "type": "string"
          },
          "avatar_url": {
            "description": "Where to fetch the avatar; absent when there is none to fetch",
            "type": "string"
          },
          "created_at": {
            "description": "RFC 3339 instant in UTC with millisecond precision",
            "format": "date-time",
            "pattern": "^(?:[1-9][0-9]{3}|0[1-9][0-9]{2}|00[1-9][0-9]|000[2-9])-",
            "patternDescription": "a non-zero RFC 3339 instant",
            "type": "string"
          },
          "has_pin": {
            "type": "boolean"
          },
          "id": {
            "description": "Opaque identifier",
            "minLength": 1,
            "type": "string"
          },
          "is_child": {
            "type": "boolean"
          },
          "is_primary": {
            "description": "The household parent (not the server admin role)",
            "type": "boolean"
          },
          "language": {
            "description": "Preferred audio language (ISO 639-1); empty inherits",
            "type": "string"
          },
          "library_restrictions_enabled": {
            "type": "boolean"
          },
          "max_content_rating": {
            "description": "Content-rating ceiling; empty means none",
            "type": "string"
          },
          "max_playback_quality": {
            "description": "Playback ceiling; empty means none",
            "enum": [
              "1080p",
              "2160p"
            ],
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "preferred_metadata_language": {
            "description": "Metadata language (ISO 639-1); empty inherits the library's",
            "type": "string"
          },
          "quality_preference": {
            "description": "Empty when unset",
            "enum": [
              "auto",
              "original"
            ],
            "type": "string"
          },
          "show_forced_subtitles": {
            "type": "boolean"
          },
          "subtitle_language": {
            "description": "Preferred subtitle language (ISO 639-1); empty inherits",
            "type": "string"
          },
          "subtitle_mode": {
            "description": "Empty when unset",
            "enum": [
              "auto",
              "always",
              "off"
            ],
            "type": "string"
          },
          "updated_at": {
            "description": "RFC 3339 instant in UTC with millisecond precision",
            "format": "date-time",
            "pattern": "^(?:[1-9][0-9]{3}|0[1-9][0-9]{2}|00[1-9][0-9]|000[2-9])-",
            "patternDescription": "a non-zero RFC 3339 instant",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "avatar",
          "avatar_source",
          "has_pin",
          "is_child",
          "is_primary",
          "max_content_rating",
          "quality_preference",
          "language",
          "preferred_metadata_language",
          "subtitle_language",
          "subtitle_mode",
          "auto_skip_intro",
          "auto_skip_credits",
          "auto_skip_recap",
          "auto_play_next_preview",
          "show_forced_subtitles",
          "library_restrictions_enabled",
          "allowed_library_ids",
          "max_playback_quality",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "ProfileUpdate": {
        "additionalProperties": false,
        "properties": {
          "allowed_library_ids": {
            "description": "Replaces the allowlist; an empty array allows none",
            "items": {
              "description": "Opaque identifier",
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "auto_play_next_preview": {
            "type": "boolean"
          },
          "auto_skip_credits": {
            "type": "boolean"
          },
          "auto_skip_intro": {
            "type": "boolean"
          },
          "auto_skip_recap": {
            "type": "boolean"
          },
          "avatar": {
            "description": "Preset avatar reference; null removes the avatar",
            "type": [
              "string",
              "null"
            ]
          },
          "is_child": {
            "type": "boolean"
          },
          "language": {
            "description": "Preferred audio language (ISO 639-1); null inherits",
            "type": [
              "string",
              "null"
            ]
          },
          "library_restrictions_enabled": {
            "type": "boolean"
          },
          "max_content_rating": {
            "description": "Content-rating ceiling; null removes it",
            "type": [
              "string",
              "null"
            ]
          },
          "max_playback_quality": {
            "description": "Playback ceiling; null removes it",
            "enum": [
              "1080p",
              "2160p"
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "description": "Display name; leading and trailing spaces are trimmed",
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "pin": {
            "description": "New PIN; null removes the PIN",
            "type": [
              "string",
              "null"
            ]
          },
          "preferred_metadata_language": {
            "description": "Metadata language (ISO 639-1); null inherits the library's",
            "type": [
              "string",
              "null"
            ]
          },
          "quality_preference": {
            "enum": [
              "auto",
              "original"
            ],
            "type": "string"
          },
          "show_forced_subtitles": {
            "type": "boolean"
          },
          "subtitle_language": {
            "description": "Preferred subtitle language (ISO 639-1); null inherits",
            "type": [
              "string",
              "null"
            ]
          },
          "subtitle_mode": {
            "enum": [
              "auto",
              "always",
              "off"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "ProgressCollection": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "description": "The page's items; empty, never null",
            "items": {
              "$ref": "#/components/schemas/ProgressEntry"
            },
            "type": "array"
          },
          "page": {
            "$ref": "#/components/schemas/PageInfo",
            "description": "Cursor state; absent for bounded unpaginated collections"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "ProgressEntry": {
        "additionalProperties": false,
        "properties": {
          "completed": {
            "description": "Whether the item counts as watched",
            "type": "boolean"
          },
          "duration_seconds": {
            "description": "Known runtime; 0 when unknown",
            "format": "double",
            "type": "number"
          },
          "media_item_id": {
            "description": "The catalog item",
            "minLength": 1,
            "type": "string"
          },
          "position_seconds": {
            "description": "Playback position",
            "format": "double",
            "type": "number"
          },
          "updated_at": {
            "description": "When the position last changed",
            "format": "date-time",
            "pattern": "^(?:[1-9][0-9]{3}|0[1-9][0-9]{2}|00[1-9][0-9]|000[2-9])-",
            "patternDescription": "a non-zero RFC 3339 instant",
            "type": "string"
          }
        },
        "required": [
          "media_item_id",
          "position_seconds",
          "duration_seconds",
          "completed",
          "updated_at"
        ],
        "type": "object"
      },
      "SetupStatus": {
        "additionalProperties": false,
        "properties": {
          "needs_setup": {
            "description": "True until the first administrator account exists",
            "type": "boolean"
          }
        },
        "required": [
          "needs_setup"
        ],
        "type": "object"
      },
      "SystemInfo": {
        "additionalProperties": false,
        "properties": {
          "api_major": {
            "description": "The native API major this server serves at this path",
            "format": "int64",
            "type": "integer"
          },
          "contract_digest": {
            "description": "SHA-256 (hex) of the exact committed OpenAPI artifact served at links.openapi. Diagnostic and cache-identity only: never feature-detect on it.",
            "type": "string"
          },
          "links": {
            "$ref": "#/components/schemas/SystemInfoLinks",
            "description": "Stable links to the contract and to capability documents"
          },
          "server_version": {
            "description": "Server build identity (short revision, +dirty when built from a modified tree, or \"unavailable\"). Diagnostic only: never feature-detect on it.",
            "type": "string"
          }
        },
        "required": [
          "server_version",
          "api_major",
          "contract_digest",
          "links"
        ],
        "type": "object"
      },
      "SystemInfoLinks": {
        "additionalProperties": false,
        "properties": {
          "capabilities": {
            "description": "Path prefix of the per-domain capability documents",
            "type": "string"
          },
          "openapi": {
            "description": "Path of the committed OpenAPI artifact",
            "type": "string"
          }
        },
        "required": [
          "openapi",
          "capabilities"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "description": "A session token or an API key in the Authorization header. The server decides which it holds.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Silo API",
    "version": "2"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v2/account/me": {
      "get": {
        "operationId": "getCurrentUser",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "406": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Acceptable"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Get the authenticated caller's login account.",
        "tags": [
          "account"
        ],
        "x-silo-class": "authenticated"
      }
    },
    "/api/v2/openapi.json": {
      "get": {
        "operationId": "getOpenAPIDocument",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "description": "An OpenAPI 3.1 document. Its members are fixed by the OpenAPI specification, not by this contract.",
                  "type": "object",
                  "x-silo-extension-bag": "openapi-document"
                }
              }
            },
            "description": "The OpenAPI 3.1 document, exactly the committed contracts/api/v2/openapi.json bytes.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              },
              "Content-Type": {
                "schema": {
                  "type": "string"
                }
              },
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "406": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Acceptable"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Get the committed OpenAPI document this server was built from.",
        "tags": [
          "system"
        ],
        "x-silo-class": "public"
      }
    },
    "/api/v2/profiles/{id}": {
      "patch": {
        "operationId": "updateProfile",
        "parameters": [
          {
            "description": "Optional. When present, it must name a profile of the authenticated account.",
            "in": "header",
            "name": "X-Profile-Id",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The profile to update",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "The profile to update",
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileUpdate"
              }
            },
            "application/octet-stream": {
              "schema": {
                "contentMediaType": "application/octet-stream",
                "format": "binary",
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "406": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Acceptable"
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "415": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unsupported Media Type"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Update a household profile; omitted members are unchanged.",
        "tags": [
          "profiles"
        ],
        "x-silo-class": "profile_scoped",
        "x-silo-demo-restricted": true
      }
    },
    "/api/v2/progress": {
      "get": {
        "operationId": "listProgress",
        "parameters": [
          {
            "description": "The household profile acting for this request; it must belong to the authenticated account.",
            "in": "header",
            "name": "X-Profile-Id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Only entries in this state; absent lists every entry",
            "explode": false,
            "in": "query",
            "name": "status",
            "schema": {
              "description": "Only entries in this state; absent lists every entry",
              "enum": [
                "in_progress",
                "completed"
              ],
              "type": "string"
            }
          },
          {
            "description": "Only entries whose item is in this library",
            "explode": false,
            "in": "query",
            "name": "library_id",
            "schema": {
              "description": "Only entries whose item is in this library",
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "description": "Page size; default 50, maximum 200",
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 50,
              "description": "Page size; default 50, maximum 200",
              "format": "int64",
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Opaque cursor from page.next_cursor",
            "explode": false,
            "in": "query",
            "name": "cursor",
            "schema": {
              "description": "Opaque cursor from page.next_cursor",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProgressCollection"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
