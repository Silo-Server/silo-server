{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siloserver.org/contracts/api/v2/migration.schema.json",
  "title": "Silo pre-1.0 native surface to /api/v2 migration ledger",
  "description": "One entry per row of contracts/api/v2/route-inventory.json. internal/contractledger validates this schema and reconciles the ledger against the inventory in CI.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "description", "source_inventory", "source_trees", "consumer_method", "field_reference", "totals", "entries"],
  "properties": {
    "schema_version": { "const": 1 },
    "description": { "type": "string", "minLength": 1 },
    "source_inventory": { "const": "contracts/api/v2/route-inventory.json" },
    "source_trees": {
      "$comment": "The trees the consumer call sites were extracted from. Sibling repos are pinned to the origin/main commit SHA used for extraction so a site can be re-resolved against that exact tree; web and server sites are in this repository at the same commit as the ledger.",
      "type": "object",
      "additionalProperties": false,
      "required": ["silo-apple", "silo-android", "silo-server"],
      "properties": {
        "silo-apple": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "silo-android": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "silo-server": { "const": "this repository" }
      }
    },
    "consumer_method": { "type": "string", "minLength": 1 },
    "field_reference": { "type": "string", "minLength": 1 },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries"],
      "properties": { "entries": { "type": "integer", "minimum": 0 } }
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "listener": { "enum": ["root", "api", "api_v2", "proxy", "transcode_node"] },
    "namespace": { "enum": ["api_v1", "api_v2", "legacy_unversioned", "operational"] },
    "method": { "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "CONNECT", "TRACE"] },
    "path": { "type": "string", "pattern": "^/" },
    "handlerKind": { "enum": ["method", "func", "expression", "literal", "delegation"] },
    "authClass": { "enum": ["public", "authenticated", "profile_scoped", "acting_admin", "permission_gated", "node_bearer", "delegated"] },
    "authTrait": {
      "enum": [
        "acting_admin", "authenticated", "cors", "delegated", "demo_guarded", "egress_metered",
        "marker_edit", "metadata_curation", "node_bearer", "optional_viewer_access",
        "profile_required", "rate_limited", "viewer_access"
      ]
    },
    "requestKind": { "enum": ["none", "json", "multipart", "binary", "range", "dynamic_proxy", "unknown"] },
    "responseMediaKind": { "enum": ["json", "multipart", "binary", "range", "redirect", "websocket", "html", "css", "dynamic_proxy", "unknown"] },
    "consumer": { "enum": ["web", "apple", "android", "internal", "compat", "external_unknown", "unused"] },
    "callSiteRepo": { "enum": ["web", "apple", "android", "server"] },
    "matchKind": {
      "$comment": "mechanical: extract_consumers.py resolved the path at the site. manual: a maintainer resolved a path the scripts cannot follow. follower: the client fetches a server-supplied URL; the site is the resolver or allowlist that admits it, so the route's path is not spelled there.",
      "enum": ["mechanical", "manual", "follower"]
    },
    "section": {
      "description": "The API section (Phase 4 delivery unit) that ports, retires, or documents this row in one section PR. Assigned by scripts/apiv2-ledger/assign_sections.py from listener, namespace and path; regenerate rather than edit.",
      "enum": [
        "admin-autoscan",
        "admin-catalog",
        "admin-collections",
        "admin-history-imports",
        "admin-invitations",
        "admin-nodes",
        "admin-notifications",
        "admin-observability",
        "admin-plugins",
        "admin-policy",
        "admin-recommendations",
        "admin-requests",
        "admin-sections",
        "admin-sessions",
        "admin-settings",
        "admin-subtitles",
        "admin-tasks",
        "admin-users",
        "auth-core",
        "auth-devices",
        "auth-invitations",
        "catalog-home",
        "catalog-items",
        "catalog-libraries",
        "catalog-recommendations",
        "downloads",
        "ebooks",
        "node-proxy",
        "node-transcode",
        "notifications",
        "operational",
        "personal-collections",
        "personal-imports",
        "personal-lists",
        "personal-progress",
        "personal-requests",
        "playback-control",
        "playback-delivery",
        "playback-subtitles",
        "plugin-proxy",
        "profiles",
        "raw-assets",
        "realtime",
        "root-operational",
        "settings",
        "settings-branding",
        "settings-prefs",
        "v2-delegation"
      ]
    },
    "releaseFlow": {
      "enum": [
        "login", "setup", "profiles", "browse_search", "playback_lifecycle", "progress", "settings",
        "notifications", "downloads", "core_admin", "other_admin", "background_refresh", "operational", "other"
      ]
    },
    "disposition": { "enum": ["ported", "redesigned", "replaced", "removed", "compatibility_only", "documented_exclusion"] },
    "dispositionRule": {
      "enum": [
        "default_ported",
        "dynamic_plugin_proxy",
        "operator_metrics",
        "listener_delegation",
        "deprecation_headers",
        "v1_scope_removals_table",
        "contract_root_probes",
        "contract_playback_start_status",
        "contract_plugin_cookie_path",
        "only_compat_consumer",
        "maintainer_decision"
      ]
    },
    "reviewState": { "enum": ["proposed", "ratified", "rejected"] },
    "capabilityEndpoint": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^GET /api/v1/[A-Za-z0-9_./{}-]+$" }
      ]
    },
    "callSite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "file", "line", "types", "match"],
      "properties": {
        "repo": { "$ref": "#/$defs/callSiteRepo" },
        "file": { "type": "string", "minLength": 1, "pattern": "^[^/]" },
        "line": { "type": "integer", "minimum": 1 },
        "path_literal_line": {
          "description": "line where the path literal is declared when it differs from the call line",
          "type": "integer",
          "minimum": 1
        },
        "types": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "match": { "$ref": "#/$defs/matchKind" }
      },
      "allOf": [
        {
          "$comment": "file is repository-root-relative for the named repo: web sites live under web/src of this repository, apple under iosApp/ of silo-apple, android under one of silo-android's four source modules, server anywhere in this repository (Go under cmd/ or internal/, or a container/build file at the root).",
          "if": { "properties": { "repo": { "const": "web" } } },
          "then": { "properties": { "file": { "pattern": "^src/" } } }
        },
        {
          "if": { "properties": { "repo": { "const": "apple" } } },
          "then": { "properties": { "file": { "pattern": "^iosApp/" } } }
        },
        {
          "if": { "properties": { "repo": { "const": "android" } } },
          "then": { "properties": { "file": { "pattern": "^(shared|android-shared|androidApp|androidTvApp)/" } } }
        },
        {
          "if": { "properties": { "repo": { "const": "server" } } },
          "then": { "properties": { "file": { "pattern": "^(cmd/|internal/|Dockerfile|docker-compose[A-Za-z0-9_.-]*\\.ya?ml$)" } } }
        }
      ]
    },
    "v2Unset": {
      "type": "object",
      "properties": {
        "method": { "type": "null" },
        "path": { "type": "null" },
        "operation_id": { "type": "null" }
      }
    },
    "v2Set": {
      "type": "object",
      "properties": {
        "method": { "$ref": "#/$defs/method" },
        "path": { "type": "string", "pattern": "^/" },
        "operation_id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" }
      }
    },
    "v2Target": {
      "$comment": "A redesigned probe row records its v2 method and path before an operation ID exists; that partially-filled shape is the only one allowed besides all-null and all-set.",
      "type": "object",
      "properties": {
        "method": { "$ref": "#/$defs/method" },
        "path": { "type": "string", "pattern": "^/" },
        "operation_id": { "type": "null" }
      }
    },
    "v2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path", "operation_id"],
      "properties": {
        "method": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/method" }] },
        "path": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^/" }] },
        "operation_id": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" }] }
      },
      "$comment": "The three fields are all null, all set, or (for a proposed redesign) method+path set with operation_id still null.",
      "oneOf": [
        { "$ref": "#/$defs/v2Unset" },
        { "$ref": "#/$defs/v2Set" },
        { "$ref": "#/$defs/v2Target" }
      ]
    },
    "owner": {
      "$comment": "Named reviewers are not recorded yet (issue #135, execution input 1); until they are, removed/redesigned/replaced rows carry the pending literal. A pending owner blocks ratification (enforced in internal/contractledger).",
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^(pending:#135/execution-input-1|[A-Za-z0-9][A-Za-z0-9 ._@-]*)$" }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "listener", "namespace", "method", "path", "registration_index",
        "handler", "handler_kind", "source_file",
        "route_group", "middleware_chain",
        "auth_class", "auth_traits", "profile_required", "admin_required",
        "conditional", "conditions", "delegates_to",
        "request_kind", "response_media_kind", "streams", "upgrades_websocket",
        "capability_endpoint",
        "consumers", "consumer_call_sites",
        "section",
        "release_flow", "tier",
        "disposition", "disposition_rule", "disposition_rationale",
        "owner", "review_state", "v2", "notes"
      ],
      "properties": {
        "listener": { "$ref": "#/$defs/listener" },
        "namespace": { "$ref": "#/$defs/namespace" },
        "method": { "$ref": "#/$defs/method" },
        "path": { "$ref": "#/$defs/path" },
        "registration_index": { "type": "integer", "minimum": 0 },
        "handler": { "type": "string", "minLength": 1 },
        "handler_kind": { "$ref": "#/$defs/handlerKind" },
        "source_file": { "type": "string", "minLength": 1, "pattern": "^(cmd|internal)/" },
        "route_group": { "$ref": "#/$defs/path" },
        "middleware_chain": { "type": "integer", "minimum": 0 },
        "auth_class": { "$ref": "#/$defs/authClass" },
        "auth_traits": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/authTrait" } },
        "profile_required": { "type": "boolean" },
        "admin_required": { "type": "boolean" },
        "conditional": { "type": "boolean" },
        "conditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "delegates_to": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/listener" }] },
        "request_kind": { "$ref": "#/$defs/requestKind" },
        "response_media_kind": { "$ref": "#/$defs/responseMediaKind" },
        "streams": { "type": "boolean" },
        "upgrades_websocket": { "type": "boolean" },
        "capability_endpoint": { "$ref": "#/$defs/capabilityEndpoint" },
        "consumers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/consumer" } },
        "consumer_call_sites": { "type": "array", "items": { "$ref": "#/$defs/callSite" } },
        "section": { "$ref": "#/$defs/section" },
        "release_flow": { "$ref": "#/$defs/releaseFlow" },
        "tier": { "enum": [1, 2] },
        "disposition": { "$ref": "#/$defs/disposition" },
        "disposition_rule": { "$ref": "#/$defs/dispositionRule" },
        "disposition_rationale": { "type": "string", "minLength": 1 },
        "owner": { "$ref": "#/$defs/owner" },
        "review_state": { "$ref": "#/$defs/reviewState" },
        "v2": { "$ref": "#/$defs/v2" },
        "notes": { "type": "string" },
        "concurrency": {
          "enum": ["if_match"],
          "description": "Optional, curated. if_match marks a resource with demonstrated lost-update risk whose v2 operation is registered Guarded (docs/architecture/api-contract.md, \"Optimistic concurrency\"): PUT/PATCH/DELETE require If-Match, a missing field is 428, a stale tag is 412. Allowed only on tier-1 ported rows whose method is PUT, PATCH or DELETE (the methods a Guarded v2 operation may use); internal/contractledger enforces that and reconciles the set against the v2 registry in both directions."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "consumers": { "contains": { "const": "unused" } } } },
          "then": { "properties": { "consumers": { "maxItems": 1 }, "consumer_call_sites": { "maxItems": 0 } } }
        },
        {
          "$comment": "disposition_rule -> allowed disposition. Each rule names the document or decision that justifies it and therefore fits exactly one disposition, except maintainer_decision, which is the escape hatch for any disposition.",
          "if": { "properties": { "disposition": { "const": "ported" } } },
          "then": { "properties": { "disposition_rule": { "enum": ["default_ported", "maintainer_decision"] } } }
        },
        {
          "if": { "properties": { "disposition": { "const": "documented_exclusion" } } },
          "then": { "properties": { "disposition_rule": { "enum": ["dynamic_plugin_proxy", "operator_metrics", "listener_delegation", "maintainer_decision"] } } }
        },
        {
          "if": { "properties": { "disposition": { "const": "removed" } } },
          "then": { "properties": { "disposition_rule": { "enum": ["v1_scope_removals_table", "deprecation_headers", "maintainer_decision"] } } }
        },
        {
          "if": { "properties": { "disposition": { "const": "redesigned" } } },
          "then": { "properties": { "disposition_rule": { "enum": ["contract_root_probes", "contract_playback_start_status", "contract_plugin_cookie_path", "maintainer_decision"] } } }
        },
        {
          "if": { "properties": { "disposition": { "const": "replaced" } } },
          "then": { "properties": { "disposition_rule": { "enum": ["v1_scope_removals_table", "maintainer_decision"] } } }
        },
        {
          "if": { "properties": { "disposition": { "const": "compatibility_only" } } },
          "then": { "properties": { "disposition_rule": { "enum": ["only_compat_consumer", "maintainer_decision"] } } }
        },
        {
          "$comment": "Nothing to port: a removed or excluded route has no v2 target.",
          "if": { "properties": { "disposition": { "enum": ["removed", "documented_exclusion"] } } },
          "then": { "properties": { "v2": { "$ref": "#/$defs/v2Unset" } } }
        },
        {
          "$comment": "A ratified port names its v2 operation completely.",
          "if": {
            "properties": {
              "disposition": { "enum": ["ported", "redesigned", "replaced"] },
              "review_state": { "const": "ratified" }
            }
          },
          "then": { "properties": { "v2": { "$ref": "#/$defs/v2Set" } } }
        },
        {
          "$comment": "Every removal, redesign, or replacement names an owner.",
          "if": { "properties": { "disposition": { "enum": ["removed", "redesigned", "replaced"] } } },
          "then": { "properties": { "owner": { "type": "string" } } }
        }
      ]
    }
  }
}
