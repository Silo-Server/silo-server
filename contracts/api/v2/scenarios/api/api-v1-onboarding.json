{
  "schema_version": 1,
  "listener": "api",
  "route_group": "/api/v1/onboarding",
  "wave": 1,
  "description": "First-run tour manifest and per-profile progress.",
  "rows": [
    {
      "listener": "api",
      "method": "GET",
      "path": "/api/v1/onboarding/flow",
      "registration_index": 0,
      "not_applicable": {
        "sorting": "Steps are in authored tour order, not sortable.",
        "pagination": "Single manifest.",
        "raw_protocol": "Plain JSON request/response; no ranges, redirects, multipart, or upgrades."
      },
      "scenarios": [
        {
          "id": "flow.ok",
          "category": "status_headers",
          "description": "The tour manifest for the web surface: 200 JSON.",
          "principal": {
            "class": "profile"
          },
          "request": {
            "path": "/api/v1/onboarding/flow"
          },
          "expect": {
            "status": 200,
            "headers": [
              {
                "name": "Content-Type",
                "op": "equals",
                "value": "application/json"
              }
            ],
            "body": [
              {
                "pointer": "",
                "op": "keys_equal",
                "value": [
                  "version",
                  "tour_id",
                  "steps"
                ]
              }
            ]
          },
          "v2_expectation": null
        },
        {
          "id": "flow.meaning",
          "category": "data_meaning",
          "description": "The current tour id and version are fixed constants; steps are non-empty and each has id and kind.",
          "principal": {
            "class": "profile"
          },
          "request": {
            "path": "/api/v1/onboarding/flow"
          },
          "expect": {
            "status": 200,
            "body": [
              {
                "pointer": "/tour_id",
                "op": "equals",
                "value": "core-2026-07"
              },
              {
                "pointer": "/version",
                "op": "equals",
                "value": 1
              },
              {
                "pointer": "/steps",
                "op": "non_empty"
              },
              {
                "pointer": "/steps",
                "op": "every",
                "value": {
                  "pointer": "",
                  "op": "keys_include",
                  "value": [
                    "id",
                    "kind"
                  ]
                }
              },
              {
                "pointer": "/steps",
                "op": "unique_by",
                "value": "/id"
              }
            ]
          },
          "v2_expectation": null
        },
        {
          "id": "flow.surface_filter",
          "category": "filtering",
          "description": "surface=tv drops steps that need input; an unknown surface is 400.",
          "principal": {
            "class": "profile"
          },
          "request": {
            "path": "/api/v1/onboarding/flow",
            "query": {
              "surface": "TV"
            }
          },
          "expect": {
            "status": 200,
            "body": [
              {
                "pointer": "/steps",
                "op": "non_empty"
              }
            ]
          },
          "v2_expectation": null
        },
        {
          "id": "flow.bad_surface",
          "category": "error",
          "description": "An unknown surface is 400 bad_request.",
          "principal": {
            "class": "profile"
          },
          "request": {
            "path": "/api/v1/onboarding/flow",
            "query": {
              "surface": "watch"
            }
          },
          "expect": {
            "status": 400,
            "headers": [
              {
                "name": "Content-Type",
                "op": "equals",
                "value": "application/json"
              }
            ],
            "body": [
              {
                "pointer": "/error",
                "op": "equals",
                "value": "bad_request"
              },
              {
                "pointer": "",
                "op": "keys_equal",
                "value": [
                  "error",
                  "message"
                ]
              },
              {
                "pointer": "/error",
                "op": "type",
                "value": "string"
              },
              {
                "pointer": "/message",
                "op": "type",
                "value": "string"
              },
              {
                "pointer": "/message",
                "op": "equals",
                "value": "surface must be web, phone, or tv"
              }
            ]
          },
          "v2_expectation": null
        },
        {
          "id": "flow.child_filter",
          "category": "filtering",
          "description": "A child profile receives a flow without the requests step.",
          "principal": {
            "class": "child_profile"
          },
          "request": {
            "path": "/api/v1/onboarding/flow"
          },
          "expect": {
            "status": 200,
            "body": [
              {
                "pointer": "/steps",
                "op": "non_empty"
              }
            ]
          },
          "v2_expectation": null
        },
        {
          "id": "flow.shape",
          "category": "field_presence_nullability",
          "description": "steps is an array; optional step fields are omitted when empty.",
          "principal": {
            "class": "profile"
          },
          "request": {
            "path": "/api/v1/onboarding/flow"
          },
          "expect": {
            "status": 200,
            "body": [
              {
                "pointer": "/steps",
                "op": "type",
                "value": "array"
              }
            ]
          },
          "v2_expectation": null
        },
        {
          "id": "flow.no_profile",
          "category": "authorization",
          "description": "Without X-Profile-Id the RequireProfile middleware answers 400 bad_request (not 401/403).",
          "principal": {
            "class": "authenticated"
          },
          "request": {
            "path": "/api/v1/onboarding/flow"
          },
          "expect": {
            "status": 400,
            "headers": [
              {
                "name": "Content-Type",
                "op": "equals",
                "value": "application/json"
              }
            ],
            "body": [
              {
                "pointer": "/error",
                "op": "equals",
                "value": "bad_request"
              },
              {
                "pointer": "",
                "op": "keys_equal",
                "value": [
                  "error",
                  "message"
                ]
              },
              {
                "pointer": "/error",
                "op": "type",
                "value": "string"
              },
              {
                "pointer": "/message",
                "op": "type",
                "value": "string"
              },
              {
                "pointer": "/message",
                "op": "equals",
                "value": "X-Profile-Id header is required"
              }
            ]
          },
          "notes": "Missing profile header is a 400, the same status as a malformed body; flagged for the section PR.",
          "v2_expectation": null
        },
        {
          "id": "flow.other_account_profile",
          "category": "authorization",
          "description": "A member bearer declaring a profile owned by another account (the admin's primary) is 404 not_found from viewer access: the profile lookup is scoped to the bearer's account, so a foreign profile is indistinguishable from an unknown one.",
          "principal": {
            "class": "profile",
            "profile": "admin_primary"
          },
          "request": {
            "path": "/api/v1/onboarding/flow"
          },
          "expect": {
            "status": 404,
            "headers": [
              {
                "name": "Content-Type",
                "op": "equals",
                "value": "application/json"
              }
            ],
            "body": [
              {
                "pointer": "/error",
                "op": "equals",
                "value": "not_found"
              },
              {
                "pointer": "",
                "op": "keys_equal",
                "value": [
                  "error",
                  "message"
                ]
              },
              {
                "pointer": "/error",
                "op": "type",
                "value": "string"
              },
              {
                "pointer": "/message",
                "op": "type",
                "value": "string"
              },
              {
                "pointer": "/message",
                "op": "equals",
                "value": "Profile not found"
              }
            ]
          },
          "notes": "Cross-account probe. The 404 (not 403) is the current scoped-lookup behavior; recorded as-is.",
          "v2_expectation": null
        },
        {
          "id": "flow.no_token",
          "category": "authorization",
          "description": "Without a bearer the auth middleware refuses the request before the handler runs.",
          "principal": {
            "class": "public"
          },
          "request": {
            "path": "/api/v1/onboarding/flow"
          },
          "expect": {
            "status": 401,
            "headers": [
              {
                "name": "Content-Type",
                "op": "equals",
                "value": "application/json"
              }
            ],
            "body": [
              {
                "pointer": "/error",
                "op": "equals",
                "value": "unauthorized"
              },
              {
                "pointer": "",
                "op": "keys_equal",
                "value": [
                  "error",
                  "message"
                ]
              },
              {
                "pointer": "/error",
                "op": "type",
                "value": "string"
              },
              {
                "pointer": "/message",
                "op": "type",
                "value": "string"
              },
              {
                "pointer": "/message",
                "op": "equals",
                "value": "Missing or malformed authorization header"
              }
            ]
          },
          "v2_expectation": null
        }
      ]
    },
