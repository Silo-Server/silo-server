    {
      "listener": "api",
      "method": "POST",
      "path": "/api/v1/onboarding/progress",
      "registration_index": 0,
      "not_applicable": {
        "sorting": "Single object response; nothing to order.",
        "pagination": "Single object response; nothing to page.",
        "raw_protocol": "Plain JSON request/response; no ranges, redirects, multipart, or upgrades."
      },
      "scenarios": [
        {
          "id": "progress.ok",
          "category": "status_headers",
          "description": "Recording progress answers 204.",
          "principal": {
            "class": "profile"
          },
          "request": {
            "path": "/api/v1/onboarding/progress",
            "body": {
              "tour_id": "core-2026-07",
              "last_step": "welcome"
            }
          },
          "expect": {
            "status": 204,
            "body_kind": "empty"
          },
          "v2_expectation": null
        },
        {
          "id": "progress.completed_monotonic",
          "category": "data_meaning",
          "description": "Marking completed sets done; a later write without completed moves last_step but cannot clear completed_at (monotonic).",
          "principal": {
            "class": "profile"
          },
          "request": {
            "path": "/api/v1/onboarding/progress",
            "body": {
              "last_step": "finish",
              "completed": true
            }
          },
          "expect": {
            "status": 204,
            "body_kind": "empty"
          },
          "fresh_state": true,
          "then": [
            {
              "method": "GET",
              "description": "state reports done after completion",
              "request": {
                "path": "/api/v1/onboarding/state"
              },
              "expect": {
                "status": 200,
                "body": [
                  {
                    "pointer": "/done",
                    "op": "equals",
                    "value": true
                  },
                  {
                    "pointer": "/last_step",
                    "op": "equals",
                    "value": "finish"
                  },
                  {
                    "pointer": "/completed_at",
                    "op": "rfc3339"
                  },
                  {
                    "pointer": "/skipped_at",
                    "op": "absent"
                  }
                ]
              }
            },
            {
              "method": "POST",
              "description": "a later plain progress write",
              "request": {
                "path": "/api/v1/onboarding/progress",
                "body": {
                  "last_step": "welcome"
                }
              },
              "expect": {
                "status": 204,
                "body_kind": "empty"
              }
            },
            {
              "method": "GET",
              "description": "completed_at survives the later write",
              "request": {
                "path": "/api/v1/onboarding/state"
              },
              "expect": {
                "status": 200,
                "body": [
                  {
                    "pointer": "/done",
                    "op": "equals",
                    "value": true
                  },
                  {
                    "pointer": "/last_step",
                    "op": "equals",
                    "value": "welcome"
                  },
                  {
                    "pointer": "/completed_at",
                    "op": "rfc3339"
                  }
                ]
              }
            }
          ],
          "v2_expectation": null
        },
