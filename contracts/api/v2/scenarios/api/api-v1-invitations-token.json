        {
          "id": "inv_lookup.rate_limited.r1",
          "category": "status_headers",
          "description": "The rate-limited registration variant answers 429 with Retry-After once the per-IP invitation burst (10) is spent.",
          "principal": {
            "class": "public"
          },
          "request": {
            "path": "/api/v1/invitations/x/",
            "repeat": 11
          },
          "expect": {
            "status": 429,
            "headers": [
              {
                "name": "Retry-After",
                "op": "matches",
                "value": "^[0-9]+$"
