    {
      "name": "list_admin_users_offset_rejected",
      "operation_id": "listAdminUsers",
      "scenario": "The v1 offset parameter is not part of v2 pagination; the account listing refuses it as unknown.",
      "request": {
        "method": "GET",
        "path": "/api/v2/admin/users?offset=50",
        "headers": {
          "Authorization": "Bearer tok-admin"
        }
      },
      "expected_status": 422,
      "response_headers": {
        "Cache-Control": "no-store",
        "Content-Type": "application/problem+json"
      },
      "response_media_type": "application/problem+json",
      "schema": "#/components/schemas/Problem",
      "body_file": "list_admin_users_offset_rejected.json"
    },
    {
      "name": "list_admin_users_ok",
