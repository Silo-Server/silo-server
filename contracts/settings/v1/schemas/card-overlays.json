{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silo-server.dev/contracts/settings/v1/schemas/card-overlays.json",
  "title": "Card overlay preferences",
  "description": "Badges painted on poster cards. Mirrors CardOverlayPrefs in web/src/lib/overlays/types.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "preset", "order", "items"],
  "properties": {
    "version": { "const": 2 },
    "preset": {
      "type": "string",
      "enum": ["minimal", "classic", "vibrant", "pill", "square", "plate", "band"]
    },
    "watchStatus": {
      "description": "What the top-right status corner shows: a check on watched titles plus the episodes left on a started series (remaining), only the check (watched), or nothing (off). Absent means remaining.",
      "type": "string",
      "enum": ["remaining", "watched", "off"]
    },
    "style": {
      "description": "Overrides on top of the preset. Each absent field keeps the preset's own value.",
      "$ref": "#/$defs/style"
    },
    "order": {
      "description": "Explicit render order. Empty means use the registry's own order.",
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/overlayId" }
    },
    "items": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/overlayId" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enabled", "position"],
        "properties": {
          "enabled": { "type": "boolean" },
          "position": { "$ref": "#/$defs/position" },
          "accentColor": {
            "description": "Hex colour. Absent means the overlay's own default accent.",
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "showIcon": {
            "description": "Absent means inherit from the preset.",
            "type": "boolean"
          },
          "image": {
            "description": "Uploaded image drawn in place of the badge's icon, beside its label. Absent means the built-in icon.",
            "$ref": "#/$defs/imageRef"
          },
          "valueImages": {
            "description": "Uploaded images that replace the whole badge when its value key matches, for example {\"4K\": ref}. Keys are the value keys docs/architecture/card-overlays.md lists per badge.",
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "additionalProperties": { "$ref": "#/$defs/imageRef" }
          }
        }
      }
    }
  },
  "$defs": {
    "overlayId": {
      "type": "string",
      "enum": [
        "resolution",
        "hdr",
        "resolution_hdr",
        "audio",
        "audio_channels",
        "video_codec",
        "container",
        "aspect_ratio",
        "release_type",
        "edition",
        "multi_audio",
        "multi_sub",
        "rating_imdb",
        "rating_tmdb",
        "rating_rt",
        "rating_rt_audience",
        "content_rating",
        "advisory_age",
        "request_status",
        "year",
        "runtime",
        "original_language",
        "studio",
        "network",
        "show_status",
        "imdb_top_250",
        "rt_certified_fresh"
      ]
    },
    "position": {
      "description": "Where a badge sits. top-right is reserved for the status corner: clients draw a badge stored there on the right edge and write right-edge instead.",
      "type": "string",
      "enum": ["top-left", "top-right", "bottom-left", "bottom-right", "left-edge", "right-edge"]
    },
    "imageRef": {
      "description": "Content reference of an image an administrator uploaded, as listed by the overlay-config endpoint.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}\\.webp$"
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "description": "Scale applied to the preset's text, padding and icons.",
          "type": "number",
          "minimum": 0.75,
          "maximum": 2
        },
        "shape": {
          "type": "string",
          "enum": ["pill", "rounded", "square"]
        },
        "background": {
          "description": "Badge fill, #RRGGBBAA.",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{8}$"
        },
        "textColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "borderColor": {
          "description": "#RRGGBBAA.",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{8}$"
        },
        "borderWidth": {
          "description": "Border width at the 185-unit reference card width.",
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "fontWeight": {
          "type": "string",
          "enum": ["medium", "semibold", "bold", "black"]
        },
        "uppercase": { "type": "boolean" },
        "shadow": {
          "description": "Drop shadow under the badge.",
          "type": "boolean"
        }
      }
    }
  }
}
