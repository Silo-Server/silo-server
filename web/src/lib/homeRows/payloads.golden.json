    "custom_filter/rules/home": {
      "scope": "home",
      "section_type": "custom_filter",
      "title": "90s Horror",
      "featured": false,
      "item_limit": 20,
      "config": {
        "library_ids": [
          1
        ],
        "media_scope": "movie",
        "match": "any",
        "groups": [
          {
            "match": "all",
            "rules": [
              {
                "field": "genre",
                "op": "contains",
                "value": "Horror"
              },
              {
                "field": "year",
                "op": "between",
                "value": [
                  1990,
                  1999
                ]
              }
            ]
          },
          {
            "match": "any",
            "rules": [
              {
                "field": "rating_imdb",
                "op": "gte",
                "value": 7.5
              }
            ]
          }
        ],
        "sort": {
          "field": "rating_imdb",
          "order": "desc"
        }
      },
      "enabled": true
    },
