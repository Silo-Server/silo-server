#!/command/with-contenv bash
# shellcheck shell=bash
# Create the silo database and the extensions Silo's migrations expect.
set -euo pipefail
# shellcheck source=omnibus/rootfs/etc/silo-omnibus/lib.sh
source /etc/silo-omnibus/lib.sh

enabled postgres || exit 0
export HOME=/config/silo

psql_silo() {
  s6-setuidgid silo psql -v ON_ERROR_STOP=1 -qAtX -h /run/postgresql -U silo "$@"
}

if [[ "$(psql_silo -d postgres -c "SELECT 1 FROM pg_database WHERE datname = 'silo'")" != "1" ]]; then
  log "creating the silo database"
  psql_silo -d postgres -c 'CREATE DATABASE silo'
fi
psql_silo -d silo -c 'CREATE EXTENSION IF NOT EXISTS vector; CREATE EXTENSION IF NOT EXISTS pg_trgm; CREATE EXTENSION IF NOT EXISTS citext;'
