#!/command/with-contenv bash
# shellcheck shell=bash
# Point Silo's catalog search at the bundled Meilisearch when it is enabled,
# and back at PostgreSQL when it is turned off again.
#
# The three keys written here are part of Silo's published settings contract.
# The Meilisearch URL and API key are read at start, so they are seeded before
# Silo runs. Silo encrypts the stored key on its next start and rebuilds the
# search index on its own once it sees the provider change.
set -euo pipefail
# shellcheck source=omnibus/rootfs/etc/silo-omnibus/lib.sh
source /etc/silo-omnibus/lib.sh

export HOME=/config/silo
cd /config/silo

run_sql() {
  s6-setuidgid silo psql -v ON_ERROR_STOP=1 -qAtX "$@" "$DATABASE_URL"
}

if enabled meilisearch; then
  # server_settings only exists after the first migration.
  if ! s6-setuidgid silo silo --migrate-only >/dev/null; then
    warn "database migration failed; Silo will retry when it starts. Configure Meilisearch under Admin > Settings > Search if search stays on PostgreSQL."
    exit 0
  fi
  key="$(<"$STATE_DIR/meili-master-key")"
  if run_sql -v url="http://127.0.0.1:7700" -v key="$key" <<'SQL'
INSERT INTO server_settings (key, value) VALUES
  ('catalog.search.provider', 'meilisearch'),
  ('catalog.search.meilisearch.url', :'url'),
  ('catalog.search.meilisearch.api_key', :'key')
ON CONFLICT (key) DO UPDATE SET value = EXCLUDED.value;
SQL
  then
    log "catalog search provider set to the bundled Meilisearch"
  else
    warn "could not write the search settings; configure Meilisearch under Admin > Settings > Search"
  fi
else
  # Only undo our own setting: a provider that points at the bundled instance.
  if ! run_sql <<'SQL'
DO $$
BEGIN
  IF to_regclass('public.server_settings') IS NOT NULL THEN
    UPDATE server_settings SET value = 'postgres'
     WHERE key = 'catalog.search.provider' AND value = 'meilisearch'
       AND EXISTS (SELECT 1 FROM server_settings
                    WHERE key = 'catalog.search.meilisearch.url'
                      AND value = 'http://127.0.0.1:7700');
  END IF;
END
$$;
SQL
  then
    warn "could not check the search provider setting"
  fi
fi
