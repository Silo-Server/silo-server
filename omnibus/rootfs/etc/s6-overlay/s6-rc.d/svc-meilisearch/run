#!/command/with-contenv bash
# shellcheck shell=bash
set -euo pipefail
# shellcheck source=omnibus/rootfs/etc/silo-omnibus/lib.sh
source /etc/silo-omnibus/lib.sh
if ! enabled meilisearch; then
  notify_ready
  exec sleep infinity
fi
export HOME=/config/meilisearch
# Defaults only; any MEILI_* variable set on the container takes precedence.
: "${MEILI_DB_PATH:=/config/meilisearch/data}"
: "${MEILI_DUMP_DIR:=/config/meilisearch/dumps}"
: "${MEILI_SNAPSHOT_DIR:=/config/meilisearch/snapshots}"
: "${MEILI_HTTP_ADDR:=127.0.0.1:7700}"
: "${MEILI_ENV:=production}"
: "${MEILI_NO_ANALYTICS:=true}"
MEILI_MASTER_KEY="$(<"$STATE_DIR/meili-master-key")"
export MEILI_DB_PATH MEILI_DUMP_DIR MEILI_SNAPSHOT_DIR MEILI_HTTP_ADDR MEILI_ENV MEILI_NO_ANALYTICS MEILI_MASTER_KEY
exec s6-notifyoncheck -d -n 0 -w 1000 \
  s6-setuidgid meilisearch meilisearch
